# ---- third-party libraries: include dirs only (see the header)
macro(PH_INTERFACE_LIBRARY _target)
    if (NOT TARGET ${_target})
        add_library(${_target} INTERFACE IMPORTED GLOBAL)
        set_target_properties(${_target} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${ARGN}")
    endif ()
endmacro()

PH_INTERFACE_LIBRARY(Freetype::Freetype "${PH_DEPS}/include/freetype2")
PH_INTERFACE_LIBRARY(HarfBuzz::HarfBuzz "${PH_DEPS}/include/harfbuzz")
PH_INTERFACE_LIBRARY(HarfBuzz::ICU "${PH_DEPS}/include/harfbuzz")
PH_INTERFACE_LIBRARY(LibXml2::LibXml2 "${PH_DEPS}/include/libxml2")
PH_INTERFACE_LIBRARY(LibXslt::LibXslt "${PH_DEPS}/include")   # ENABLE_XSLT (build_webdeps.sh libxslt)
PH_INTERFACE_LIBRARY(SQLite3::SQLite3 "${PH_DEPS}/include")
PH_INTERFACE_LIBRARY(WebP::libwebp "${PH_DEPS}/include")
PH_INTERFACE_LIBRARY(WebP::demux "${PH_DEPS}/include")
PH_INTERFACE_LIBRARY(WebP::mux "${PH_DEPS}/include")
PH_INTERFACE_LIBRARY(PNG::PNG "${PH_DEPS}/include")   # libpng (build_png_nspsl.sh)
PH_INTERFACE_LIBRARY(JPEG::JPEG "${PH_DEPS}/include")   # libjpeg-turbo (build_webdeps.sh)
PH_INTERFACE_LIBRARY(CURL::libcurl "${PH_DEPS}/include")   # the OpenSSL build (build_curl_ossl.sh)
